# =============================================================================
# 유료 API 보호용 비밀번호
#
#   /chat 은 호출 한 번마다 임베딩(검색) + LLM(생성) 으로 실제 요금이 청구됩니다.
#   데모 서버가 LAN/인터넷에 열려 있으면 누구나 크레딧을 소진시킬 수 있으므로,
#   이 비밀번호를 입력해야만 질의할 수 있습니다.
#   (/health 와 /docs 는 과금이 없어 그대로 공개됩니다.)
#
# 사용법:
#   cp .env_pwd.example .env_pwd
#   .env_pwd 를 열어 PAID_MODEL_PASSWORD 를 실제 값으로 바꾼다
#   docker compose up -d
#
#   ! 지금 보고 있는 이 파일(.env_pwd.example)은 견본일 뿐입니다.
#     실제로 읽히는 파일은 .env_pwd — 여기를 고쳐도 아무 효과가 없습니다.
#   * 이 파일(.env_pwd)은 .gitignore 로 커밋되지 않습니다 — 서버에서 직접 생성하세요.
#   * 값을 비워 두면 /chat 은 아예 호출 불가(503)로 잠깁니다 = 안전한 기본값.
#
# ─── 비밀번호를 "나중에" 바꿀 때 (중요) ──────────────────────────────────────
#   env_file 값은 컨테이너가 "생성될 때" 한 번 주입되고 그대로 굳습니다.
#   따라서 restart 로는 절대 반영되지 않고, 컨테이너를 재생성해야 합니다.
#
#     docker compose restart agent                  # ❌ 옛 비번 유지
#     docker compose up -d --force-recreate agent   # ✅ 반영
#
#   반영됐는지 확인 (컨테이너가 실제로 들고 있는 값):
#     docker compose exec agent printenv PAID_MODEL_PASSWORD
#
#   값 작성 규칙: 따옴표·공백 없이 KEY=값 형태로. (PAID_MODEL_PASSWORD="abc" 처럼 쓰면
#   따옴표까지 값에 포함될 수 있습니다.)
# =============================================================================

# /chat 질의 시 입력할 비밀번호
PAID_MODEL_PASSWORD=change-me-please

# 비밀번호를 한 번 맞히면 재입력 없이 사용할 수 있는 시간(분). 기본 60.
#   서버가 서명된 HttpOnly 쿠키를 발급하고, 이 시간이 지나면 다시 잠깁니다.
#   비밀번호를 바꾸면 기존 쿠키는 즉시 무효가 됩니다.
# PAID_SESSION_MINUTES=60
